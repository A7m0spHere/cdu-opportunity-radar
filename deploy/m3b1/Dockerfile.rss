# Design only. No image was pulled or built during M3-B.1.
# Required input: reviewed python:3.12-slim-bookworm@sha256:<digest>.
ARG PYTHON_BASE
FROM ${PYTHON_BASE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/cdu-radar
COPY pyproject.toml README.md ./
COPY cdu_radar ./cdu_radar
RUN python -c "import sys; assert sys.version_info[:2] == (3, 12)" \
    && python -m pip install --no-cache-dir . tzdata \
    && python -c "from zoneinfo import ZoneInfo; ZoneInfo('Asia/Shanghai')" \
    && mkdir -p /var/lib/cdu-lab /var/lib/cdu-rss-state \
    && chown -R 10001:10001 /var/lib/cdu-lab /var/lib/cdu-rss-state
USER 10001:10001
ENTRYPOINT ["python", "-m", "cdu_radar"]
